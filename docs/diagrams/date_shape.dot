  "q7" [id="q7" shape=circle label="q7"];
  "q8" [id="q8" shape=circle label="q8"];
  "q9" [id="q9" shape=circle label="q9"];
  "q10" [id="q10" shape=doublecircle label="q10"];
  __start -> "q0";
  "q0" -> "q1" [label="D"];
  "q1" -> "q2" [label="D"];
  "q2" -> "q3" [label="S"];
  "q3" -> "q4" [label="D"];
  "q4" -> "q5" [label="D"];
  "q5" -> "q6" [label="S"];
  "q6" -> "q7" [label="D"];
  "q7" -> "q8" [label="D"];
