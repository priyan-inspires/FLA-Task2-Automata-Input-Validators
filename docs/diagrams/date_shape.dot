  __start [shape=point width=0.07];
  "q0" [id="q0" shape=circle label="q0"];
  "q1" [id="q1" shape=circle label="q1"];
  "q2" [id="q2" shape=circle label="q2"];
  "q3" [id="q3" shape=circle label="q3"];
